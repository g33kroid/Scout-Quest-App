# Every var below is documented as public or server-only.
# Server-only vars are read exclusively from /lib/server — never import them
# in a client component. CI greps the client bundle for these names.

# --- Public (safe to ship to the browser; NEXT_PUBLIC_ prefix required by Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never referenced outside /lib/server) ---
# Bypasses RLS entirely. Local dev / staging only in an agent session — see
# docs/tasks/00c-mcp-setup.md. Treat as burned and rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side quest translation calls only (docs/spec.md, "API and runtime").
# Never shipped to the client. Rate-limited per leader.
LLM_API_KEY=
