# Every var below is documented as public or server-only.
# Server-only vars are read exclusively from /lib/server — never import them
# in a client component. CI greps the client bundle for these names.

# --- Public (safe to ship to the browser; NEXT_PUBLIC_ prefix required by Next.js) ---
# `npx supabase start` prints these (API_URL / ANON_KEY) — see docs/runbook.md.
# Its printed values are Supabase's well-known local-dev defaults, identical
# on every machine; not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never referenced outside /lib/server) ---
# Bypasses RLS entirely. Local dev / staging only in an agent session — see
# docs/tasks/00c-mcp-setup.md. Treat as burned and rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Signs/verifies the JWTs GoTrue and our own custom scout-session minting
# both produce. `npx supabase start` prints this too (JWT_SECRET).
SUPABASE_JWT_SECRET=

# Direct Postgres connection for migrations and pgTAP (scripts/db-*.sh).
# Point at native Postgres (schema/RLS iteration) or the Supabase stack's
# DB_URL (port 54322 by default, for real integration testing) — see
# docs/runbook.md for when to use which.
DATABASE_URL=postgresql://localhost:5432/scout_quest_dev

# Server-side quest translation calls only (docs/spec.md, "API and runtime").
# Never shipped to the client. Rate-limited per leader.
LLM_API_KEY=
